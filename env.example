# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o .env — apenas o .env.example vai pro GitHub

# Banco de dados Neon
DB_HOST=ep-xxxx-xxxx.us-east-1.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=sua_senha_aqui

# Aplicação
APP_NAME=SmartCondo
APP_VERSION=2.0.0
DEBUG=False

# Segurança — troque por uma string aleatória longa
SECRET_KEY=troque-por-algo-aleatorio-longo-aqui
